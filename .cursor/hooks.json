{
  "version": 1,
  "hooks": {
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/secret-scan.cjs",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/secret-scan.cjs",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
